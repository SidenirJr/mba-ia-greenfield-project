            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 160
          },
          "expires_at": {
            "type": "string",
            "description": "Upload deadline (ISO 8601)",
            "example": "2026-11-06T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "status",
          "part_size",
          "part_count",
          "expires_at"
        ]
      },
      "PartUrlsDto": {
        "type": "object",
        "properties": {}
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned URL for the public storage endpoint; PUT the raw part bytes and keep the response ETag header",
            "example": "http://localhost:9000/streamtube/videos/uuid/original?X-Amz-..."
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          },
          "expires_in": {
            "type": "number",
            "description": "Seconds until the URLs expire",
            "example": 900
          }
        },
        "required": [
          "parts",
          "expires_in"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "size": {
            "type": "number",
            "description": "Part size in bytes",
            "example": 67108864
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\""
          }
        },
        "required": [
          "part_number",
          "size",
          "etag"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
