    "/videos/{id}/stream": {
      "get": {
        "description": "Public. Redirects (302) to a short-lived presigned URL of the object storage, which answers Range requests with 206 Partial Content. Only ready videos are available.",
        "operationId": "VideosController_streamVideo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Public id of the video",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned storage URL",
            "headers": {
              "Location": {
                "description": "Presigned GET URL on the public storage endpoint",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/download": {
      "get": {
        "description": "Public. Redirects (302) to a short-lived presigned URL of the object storage that forces Content-Disposition: attachment with the original file name. Only ready videos are available.",
        "operationId": "VideosController_downloadVideo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Public id of the video",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned storage URL",
            "headers": {
              "Location": {
                "description": "Presigned GET URL on the public storage endpoint with response-content-disposition=attachment",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download a video",
        "tags": [
          "videos"
        ]
      }
    }
  },
