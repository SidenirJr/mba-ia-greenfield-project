            "example": 160
          },
          "parts": {
            "description": "Parts already stored, ascending by part number",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
