      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Public id of the video",
            "example": "dQw4w9WgXcQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "error"
            ],
            "example": "processing"
          },
          "original_file_name": {
            "type": "string",
            "example": "holidays.mp4"
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "description": "Declared size in bytes",
            "example": 6291456
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 12.5
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1280
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 720
          },
          "video_codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "container_format": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitrate_bps": {
            "type": "number",
            "nullable": true,
            "example": 800000
          },
          "error_code": {
            "type": "string",
            "nullable": true,
            "example": "UNREADABLE_MEDIA"
          },
          "error_message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "type": "string",
            "example": "2026-11-06T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "example": "2026-11-06T12:05:00.000Z"
          }
        },
        "required": [
          "id",
          "status",
          "original_file_name",
          "content_type",
          "size_bytes",
          "duration_seconds",
          "width",
          "height",
          "video_codec",
          "container_format",
          "bitrate_bps",
          "error_code",
          "error_message",
          "created_at",
          "updated_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}